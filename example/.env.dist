# Bilderrahmen Sync – Konfiguration
# In .env umbenennen und anpassen. Leere Werte gelten als nicht gesetzt.

# --- Bilder ----------------------------------------------------------------
# Pfad zum Bilderordner auf dem Host (wird read-only als /photos eingebunden)
PHOTOS_PATH=
# Abstand der automatischen Ordner-Scans in Sekunden
SCAN_INTERVAL_SEC=3600
# Lange Kante der Vorschaubilder in px
THUMB_SIZE=480
# Parallele Lesezugriffe für Vorschauen (Netzlaufwerk schonen)
THUMB_CONCURRENCY=2

# --- FlashAir-Karte im Rahmen ---------------------------------------------
# IP der Karte. Leer = Sync deaktiviert
FLASHAIR_IP=
# HTTP Basic Auth der Karte (falls gesetzt)
FLASHAIR_USER=
FLASHAIR_PASSWORD=
# Zielordner auf der Karte
FLASHAIR_DIR=/
# Prüfabstand für Karte und Shelly in Sekunden (Rückfall zum Webhook)
REACHABILITY_INTERVAL_SEC=60
# Spiegelbetrieb: Dateien auf der Karte löschen, die nicht mehr ausgewählt sind
SYNC_DELETE_EXTRA=true
# Dateinamen auf der Karte: dcim (IMG_0001.JPG) oder original
NAMING=dcim
# Reihenfolge: random (zufällige Nummern) oder original (chronologisch)
NAMING_ORDER=random

# --- Bildaufbereitung -----------------------------------------------------
# Zielauflösung des Rahmens
TARGET_WIDTH=800
TARGET_HEIGHT=600
# crop (füllend zuschneiden), fill (einpassen + Rand füllen) oder crop+fill
FIT_MODE=crop
# Randfüllung bei fill/crop+fill: blur oder Hex-Farbe (#000000)
FILL_BACKGROUND=blur
# Bildausschnitt beim Zuschneiden: center, attention oder entropy
CROP_GRAVITY=attention
# Nur bei crop+fill: maximal weggeschnittener Anteil (0–1)
CROP_MAX_RATIO=0.2
# JPEG-Qualität der Rahmenbilder (1–100)
JPEG_QUALITY=88

# --- Shelly Plug Gen3 (Ein/Aus) -------------------------------------------
# Feste IP des Shelly. Leer = Ein/Aus ausgeblendet
SHELLY_IP=
# Kanal des Schaltausgangs
SHELLY_SWITCH_ID=0
# Nur nötig, wenn am Shelly die Authentifizierung aktiv ist
SHELLY_PASSWORD=
# Wartezeit zwischen Einschalten und Sync-Start in Sekunden
POWER_ON_SYNC_DELAY_SEC=30
# So lange gilt der Rahmen nach dem Einschalten als „startet …“ (Sekunden)
BOOT_TIMEOUT_SEC=120
# Rahmen nach einem Sync, der etwas geändert hat, aus- und wieder einschalten,
# damit er die neuen Bilder einliest (true/false). Ein Sync direkt nach einem
# Neustart löst keinen weiteren Neustart aus.
RESTART_AFTER_SYNC=true
# So lange bleibt der Rahmen beim Neustart aus (Sekunden)
RESTART_OFF_SEC=5
# Wartezeit zwischen Sync-Ende und Neustart, damit die Karte fertig schreiben kann (Sekunden)
RESTART_DELAY_SEC=10
# Token für den Webhook GET /api/hooks/power-on?token=… (empfohlen)
WEBHOOK_TOKEN=

# --- Allgemein -----------------------------------------------------------
# Port der Weboberfläche (HTTP)
PORT=8080

# --- HTTPS (optional) -----------------------------------------------------
# HTTPS einschalten. Ohne eigenes Zertifikat wird ein selbstsigniertes erzeugt
# (10 Jahre gültig, liegt im Volume photoframe_data und bleibt bei Updates gleich).
HTTPS_ENABLED=false
HTTPS_PORT=8443
# Nur wenn du den HTTPS-Port in compose.yml auf einen anderen Host-Port legst
# (z. B. "9443:8443"): der Port, den der Browser erreicht – Ziel der Umleitung.
HTTPS_PUBLIC_PORT=
# Eigenes Zertifikat: Ordner in compose.yml nach /certs einbinden und hier
# eintragen, z. B. /certs/fullchain.pem und /certs/privkey.pem. Erneuerte
# Dateien werden ohne Neustart übernommen (Prüfung alle 10 Minuten).
TLS_CERT_FILE=
TLS_KEY_FILE=
# Nur selbstsigniert: zusätzliche Namen/IPs, unter denen du die App aufrufst,
# kommagetrennt, z. B. 192.168.1.20,nas.local
TLS_HOSTNAMES=
# HTTP-Aufrufe der Oberfläche auf HTTPS umleiten. Webhook und Healthcheck
# bleiben auf HTTP erreichbar (der Shelly prüft keine Zertifikate).
HTTP_REDIRECT=true
# Zeitzone (für Zeitraum und Tageswechsel)
TZ=Europe/Berlin
# debug, info, warn oder error
LOG_LEVEL=info
