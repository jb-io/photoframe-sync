{
  "name": "photoframe-sync",
  "version": "0.1.0",
  "private": true,
  "description": "Bilder-Ordner vom Netzlaufwerk auf einen digitalen Bilderrahmen (Toshiba FlashAir) synchronisieren",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --env-file-if-exists=.env.local src/server/index.ts",
    "dev:web": "vite",
    "build": "npm run build:web && npm run build:server",
    "build:web": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node --disable-warning=ExperimentalWarning dist/server/index.js",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "photos:test": "node scripts/create-test-photos.mjs testdata/photos"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "@fastify/websocket": "^11.3.4",
    "fastify": "^5.12.7",
    "pino": "^10.4.0",
    "selfsigned": "^5.5.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@preact/preset-vite": "^2.10.6",
    "@preact/signals": "^2.11.4",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "preact": "^11.1.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
